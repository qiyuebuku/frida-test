DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jettask
DB_USER=jettask
DB_PASSWORD=changeme
REDIS_URL=redis://localhost:6379/0
SERVER_HOST=0.0.0.0
SERVER_PORT=8900
SERVICE_BASE_URL=http://127.0.0.1:8900
OCR_URL=http://127.0.0.1:5002/glmocr/parse

# ==================== Embedding 服务 ====================
EMBEDDING_URL=http://10.168.1.113:8901
EMBEDDING_MODEL=/models/Qwen3-Embedding-4B
EMBEDDING_DIM=2560
EMBEDDING_REQUEST_DIMENSIONS=false
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT=180
EMBEDDING_MAX_RETRIES=5
EMBEDDING_RETRY_BASE_DELAY=1
EMBEDDING_RETRY_MAX_DELAY=30
EMBEDDING_FILE_CACHE_ENABLED=1
EMBEDDING_FILE_CACHE_DIR=./data/embedding_cache

# ==================== Reranker 服务 ====================
RERANKER_URL=http://119.23.227.187:8860
RERANKER_TIMEOUT=15
RERANKER_MAX_DOCUMENTS=100
RERANKER_DEFAULT_TOP_N=0

# ==================== LLM Gateway ====================
LLM_PROXY_DEFAULT_PROVIDER=claude_tmux
LLM_PROXY_DEFAULT_MODEL=glm-5.1
LLM_PROXY_MODEL_ROUTES_JSON={"glm-5.1":["claude_tmux"],"deepseek-v4-flash":["deepseek"],"deepseek-v4-pro":["deepseek"]}
LLM_PROXY_MODEL_ALIASES_JSON={"glm5.1":"glm-5.1","deepseek-flash":"deepseek-v4-flash","deepseek-pro":"deepseek-v4-pro"}
LLM_PROXY_FILE_CACHE_ENABLED=1
LLM_PROXY_FILE_CACHE_DIR=./data/llm_proxy_cache

# ==================== DeepSeek Provider ====================
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=180
DEEPSEEK_MAX_CONCURRENCY=5
DEEPSEEK_RATE_LIMIT_COOLDOWN_SECONDS=60

# ==================== Knowledge Graph LLM Plan ====================
# KG only chooses model names; LLM Proxy decides provider routing.
# deepseek_cheap: every KG task uses deepseek-v4-flash.
# deepseek_balanced: extraction/retrieval controller/candidate judge use flash, planning/review tasks use pro.
# deepseek_retrieval_flash: explicit local override example for fast retrieval replay.
# glm_subscription: every KG task uses glm-5.1 via the configured LLM Proxy route.
KG_LLM_PLAN=deepseek_retrieval_flash
KG_LLM_FORCE_MODEL=
KG_LLM_PLANS_JSON={"deepseek_retrieval_flash":{"*":"deepseek-v4-flash","financial_news_extraction":"deepseek-v4-flash","financial_entity_normalization":"deepseek-v4-flash","kg_retrieval_controller":"deepseek-v4-flash","kg_candidate_judge":"deepseek-v4-flash","kg_agentic_retrieval":"deepseek-v4-flash","simple_extraction":"deepseek-v4-flash","complex_extraction":"deepseek-v4-pro","query_planning":"deepseek-v4-pro","summarization":"deepseek-v4-pro","quality_review":"deepseek-v4-pro"}}

# ==================== Langfuse Observability ====================
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
KG_LANGFUSE_ENABLED=0
KG_LANGFUSE_AUTH_CHECK=0
KG_LANGFUSE_TAGS=smart-fund-server,kg,openai-agents,agentic-rag
