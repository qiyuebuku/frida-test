    "prompt": "{\"constraints\":{\"max_turns\":6,\"max_tool_calls\":6,\"max_hits\":30,\"recall_pool_max_hits\":60,\"no_gain_round_limit\":2,\"judge_top_k\":8,\"judge_top_k_complex\":12,\"judge_top_k_max\":15,\"evidence_backfill_limit\":2,\"min_keep_evidence_to_auto_open\":1,\"min_keep_candidates_to_auto_stop\":2,\"anchor_coverage_stop_threshold\":0.8,\"max_llm_calls_normal_query\":2,\"max_llm_calls_complex_query\":3,\"max_auto_expand_candidates\":4,\"semantic_query_rewrite_limit\":3},\"available_tools\":{\"search\":\"重新组织查询并多通道召回。\",\"find\":\"在已知 evidence 内定位关键词或语义线索，必须指定 target_evidence_refs。\",\"open\":\"打开已知 evidence 或候选的父证据/窗口，必须指定 target_evidence_refs 或 target_candidate_ids。\",\"summarize\":\"压缩已验证 trace 和 evidence，不生成新事实。\",\"stop\":\"证据足够或继续无收益时停止。\"},\"observations\":[{\"tool\":\"search\",\"hit_count\":60,\"summary\":\"multi_query_search:3;semantic_queries:3\",\"hits\":[{\"hit_id\":\"kg:financial:event:baf56e90017c706d\",\"type\":\"node\",\"title\":\"霍尔木兹海峡紧张局势持续，美伊海上博弈风险升级\",\"score\":21.0,\"node_refs\":[\"kg:financial:event:baf56e90017c706d\"],\"edge_refs\":[],\"evidence_refs\":[\"kg_ev:financial:news_articles:ft_news:77547:47c72161622fab77\"],\"snippet\":\"霍尔木兹海峡紧张局势持续，美伊海上博弈风险升级\\n霍尔木兹海峡，全球关键能源运输通道与战略要地，美国伊朗两国在此展开海上博弈。美伊双方博弈的核心诉求有何根本分歧？这场对峙又将走向何方？中国国际问题研究院助理研究员李子昕指出，美伊海上博弈是以封锁对抗封锁，核心是争夺霍尔木兹海峡的控制权与规则制定权。短期紧张长期脆弱，地区局势前景不容乐观。（央视新闻）\\n霍尔木兹海峡，全球关键能源（850101）运输通道与战略要地，美国伊朗两国在此展开海上博弈\"},{\"hit_id\":\"kg_edge:financial:affects:7a7ff6ab4d656298\",\"type\":\"edge\",\"title\":\"美伊海上博弈 affects 霍尔木兹海峡\",\"score\":20.5,\"node_refs\":[\"kg:financial:event:8014f865fe2f3611\",\"kg:financial:region:35fb1281b8bb9556\"],\"edge_refs\":[\"kg_edge:financial:affects:7a7ff6ab4d656298\"],\"evidence_refs\":[\"kg_ev:financial:news_articles:ft_news:77547:47c72161622fab77\"],\"snippet\":\"霍尔木兹海峡紧张局势持续，美伊海上博弈风险升级\\n霍尔木兹海峡，全球关键能源运输通道与战略要地，美国伊朗两国在此展开海上博弈。美伊双方博弈的核心诉求有何根本分歧？这场对峙又将走向何方？中国国际问题研究院助理研究员李子昕指出，美伊海上博弈是以封锁对抗封锁，核心是争夺霍尔木兹海峡的控制权与规则制定权。短期紧张长期脆弱，地区局势前景不容乐观。（央视新闻）\\n霍尔木兹海峡，全球关键能源（85010