REMOTE_HOST=119.23.227.187
REMOTE_PORT=1113
REMOTE_USER=yuyangruan
SSH_KEY=/absolute/path/to/production-deploy-key

# Production needs a read-only deploy key for this repository.
DEPLOY_GIT_URL=git@github.com:qiyuebuku/frida-test.git
REMOTE_GIT_DIR=/home/yuyangruan/smart-fund-source
REMOTE_STATE_FILE=/home/yuyangruan/smart-fund/deployment-state.env

# Only required when the target host has no Android SDK/AVD yet. These are
# remote artifact paths or mounted artifact-store paths, never Git content.
THS_ANDROID_SDK_ARCHIVE=/opt/smart-fund-artifacts/android-sdk.tar.gz
THS_ANDROID_SDK_ARCHIVE_SHA256=replace-me
THS_AVD_ARCHIVE=/opt/smart-fund-artifacts/ths-futures-avd.tar.gz
THS_AVD_ARCHIVE_SHA256=replace-me
THS_APP_APK=/opt/smart-fund-artifacts/ths.apk
THS_APP_APK_SHA256=replace-me
THS_HOOK_APK=/opt/smart-fund-artifacts/ths-hook.apk
THS_HOOK_APK_SHA256=replace-me
THS_COLLECTOR_TEMPLATE=/opt/smart-fund-artifacts/ths-collector-template.tar.gz
THS_COLLECTOR_TEMPLATE_SHA256=replace-me
