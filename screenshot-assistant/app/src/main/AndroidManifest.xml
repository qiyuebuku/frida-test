<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 网络通信 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 开机自启（可选） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ScreenshotAssistantApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_screenshot"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenshotAssistant"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScreenshotAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 动作选择界面 -->
        <activity
            android:name=".ui.screens.ActionPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.ScreenshotAssistant"
            android:excludeFromRecents="true" />

        <!-- 测试触发器（adb am broadcast 触发截图） -->
        <receiver
            android:name=".service.CaptureCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.screenshotassistant.CAPTURE" />
            </intent-filter>
        </receiver>

        <!-- 悬浮窗服务 -->
        <service
            android:name=".service.FloatingWindowService"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_window" />
        </service>

        <!-- 无障碍服务 -->
        <service
            android:name=".service.ScreenAssistAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
