# 使用时将所需配置写入项目根目录 `.env`；部署脚本不会直接读取本文件。

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jettask
DB_USER=jettask
DB_PASSWORD=changeme
REDIS_URL=redis://localhost:6379/0
SERVER_HOST=0.0.0.0
SERVER_PORT=8900
SERVICE_BASE_URL=http://127.0.0.1:8900
SMART_FUND_MCP_BEARER_TOKEN=
SMART_FUND_MCP_TARGET=prod
SMART_FUND_MCP_ADAPTER_NAME=financial
SMART_FUND_MCP_PUBLIC_URL=http://127.0.0.1:8900/mcp
OCR_URL=http://127.0.0.1:5002/glmocr/parse

# ==================== External Research ====================
# Agent 只连接 Smart Fund MCP；按 capability 切换实际厂商。
EXTERNAL_WEB_SEARCH_PROVIDER=zhipu
EXTERNAL_WEB_READ_PROVIDER=zhipu
EXTERNAL_REPOSITORY_PROVIDER=zhipu
EXTERNAL_RESEARCH_TIMEOUT_SECONDS=60
EXTERNAL_CONTENT_TTL_SECONDS=3600
EXTERNAL_CONTENT_PREVIEW_CHARS=4000
EXTERNAL_CONTENT_MAX_PAGE_CHARS=20000

# Coding Plan 专属 Key，不是普通开放平台 API Key。
ZHIPU_CODING_PLAN_API_KEY=
ZHIPU_WEB_SEARCH_MCP_URL=https://open.bigmodel.cn/api/mcp/web_search_prime/mcp
ZHIPU_WEB_READER_MCP_URL=https://open.bigmodel.cn/api/mcp/web_reader/mcp
ZHIPU_ZREAD_MCP_URL=https://open.bigmodel.cn/api/mcp/zread/mcp

# ==================== Embedding 服务 ====================
EMBEDDING_URL=http://10.168.1.113:8901
EMBEDDING_MODEL=/models/Qwen3-Embedding-4B
EMBEDDING_DIM=2560
EMBEDDING_REQUEST_DIMENSIONS=false
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT=180
EMBEDDING_MAX_RETRIES=5
EMBEDDING_RETRY_BASE_DELAY=1
EMBEDDING_RETRY_MAX_DELAY=30
EMBEDDING_FILE_CACHE_ENABLED=1
EMBEDDING_FILE_CACHE_DIR=./data/embedding_cache

# ==================== Reranker 服务 ====================
RERANKER_URL=http://119.23.227.187:8860
RERANKER_TIMEOUT=15
RERANKER_MAX_DOCUMENTS=100
RERANKER_DEFAULT_TOP_N=0

# ==================== LLM Gateway ====================
LLM_PROXY_DEFAULT_PROVIDER=claude_tmux
LLM_PROXY_DEFAULT_MODEL=glm-5.1
LLM_PROXY_MODEL_ROUTES_JSON={"glm-5.1":["claude_tmux"],"glm-5.2":["aiclient2api","aliyun"],"deepseek-v4-flash":["aliyun"],"deepseek-v4-pro":["deepseek"],"qwen3.7-plus":["aliyun"],"kimi*":["aliyun","volcengine"],"doubao-*":["volcengine"],"glm-*":["aliyun"]}
LLM_PROXY_MODEL_ALIASES_JSON={"glm5.1":"glm-5.1","glm5.2":"glm-5.2","deepseek-flash":"deepseek-v4-flash","deepseek-pro":"deepseek-v4-pro"}
LLM_PROXY_FILE_CACHE_ENABLED=1
LLM_PROXY_FILE_CACHE_DIR=./data/llm_proxy_cache

# ==================== DeepSeek Provider ====================
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=180
DEEPSEEK_MAX_CONCURRENCY=5
DEEPSEEK_RATE_LIMIT_COOLDOWN_SECONDS=60

# ==================== Aliyun Model Studio Provider ====================
# API Key 也兼容阿里云官方使用的 DASHSCOPE_API_KEY 环境变量。
ALIYUN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_LLM_API_KEY=
ALIYUN_LLM_DEFAULT_MODEL=qwen3.7-plus
ALIYUN_LLM_TIMEOUT=1800
ALIYUN_LLM_MAX_CONCURRENCY=5
ALIYUN_LLM_RATE_LIMIT_COOLDOWN_SECONDS=60
ALIYUN_LLM_THINKING_TYPE=

# ==================== Volcengine Ark Provider ====================
# API Key 同时兼容 VOLCENGINE_ARK_API_KEY 和火山官方惯用的 ARK_API_KEY。
VOLCENGINE_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_LLM_API_KEY=
VOLCENGINE_LLM_DEFAULT_MODEL=doubao-seed-2.1-pro
VOLCENGINE_LLM_TIMEOUT=1800
VOLCENGINE_LLM_MAX_CONCURRENCY=5
VOLCENGINE_LLM_RATE_LIMIT_COOLDOWN_SECONDS=60
VOLCENGINE_LLM_THINKING_TYPE=

# ==================== AIClient2API Provider ====================
# 本地开发走公网入口；部署脚本会把生产环境改为同机内网地址。
# API Key 也兼容 AIClient2API 服务使用的 AICLIENT2API_API_KEY。
AICLIENT2API_LLM_BASE_URL=http://119.23.227.187:13000/v1
AICLIENT2API_LLM_API_KEY=
AICLIENT2API_LLM_DEFAULT_MODEL=glm-5.2
AICLIENT2API_LLM_TIMEOUT=1800
AICLIENT2API_LLM_MAX_CONCURRENCY=5
AICLIENT2API_LLM_RATE_LIMIT_COOLDOWN_SECONDS=60
# 留空表示不向上游传递思考参数，使用模型默认的隐藏思考模式。
AICLIENT2API_LLM_THINKING_TYPE=
AICLIENT2API_LLM_REASONING_EFFORT=

# ==================== OpenAI Agents SDK Runtime ====================
# 未配置时复用 SMART_FUND_MCP_PUBLIC_URL 和 AIClient2API Provider。
SMART_FUND_AGENT_MCP_URL=
SMART_FUND_AGENT_LLM_BASE_URL=
SMART_FUND_AGENT_LLM_API_KEY=
SMART_FUND_AGENT_MODEL=glm-5.2
SMART_FUND_AGENT_MCP_CONNECT_TIMEOUT=15
SMART_FUND_AGENT_MCP_TOOL_TIMEOUT=120
SMART_FUND_AGENT_LLM_TIMEOUT=500
SMART_FUND_AGENT_MAX_TURNS=12
SMART_FUND_AGENT_MAX_INPUT_CHARS=20000
SMART_FUND_AGENT_SESSION_DB=data/agent_sessions.sqlite3
SMART_FUND_AGENT_LANGFUSE_ENABLED=true
SMART_FUND_AGENT_TRACE_SENSITIVE_DATA=false

# 新增其他 OpenAI-compatible 厂商时使用声明式配置；每个厂商维护自己的模型目录。
# model_mappings 的 key 是网关 canonical model，value 是该厂商的 upstream model/endpoint ID。
# LLM_PROXY_OPENAI_COMPATIBLE_PROVIDERS_JSON={"volcengine":{"base_url":"https://ark.cn-beijing.volces.com/api/v3","api_key_env":"ARK_API_KEY","default_model":"your-endpoint-id","timeout":1800,"model_patterns":["doubao-*"],"model_mappings":{"deepseek-v4-pro":"your-deepseek-endpoint-id"}}}

# ==================== Knowledge Graph LLM Plan ====================
# KG only chooses model names; LLM Proxy decides provider routing.
# deepseek_cheap: every KG task uses deepseek-v4-flash.
# deepseek_balanced: extraction/retrieval controller/candidate judge use flash, planning/review tasks use pro.
# deepseek_retrieval_flash: explicit local override example for fast retrieval replay.
# glm_subscription: every KG task uses glm-5.1 via the configured LLM Proxy route.
KG_LLM_PLAN=deepseek_retrieval_flash
KG_LLM_FORCE_MODEL=glm-5.2
KG_COGNITIVE_CARD_SIMPLE_MODEL=deepseek-v4-flash
KG_COGNITIVE_CARD_COMPLEX_MODEL=deepseek-v4-pro
KG_COGNITIVE_CARD_SIMPLE_MAX_SENTENCE_BLOCKS=6
KG_COGNITIVE_CARD_SIMPLE_MAX_CHARS=2500
KG_COGNITIVE_CARD_THINKING_TYPE=
KG_RELATION_PROBE_THINKING_TYPE=
KG_LLM_PLANS_JSON={"deepseek_retrieval_flash":{"*":"deepseek-v4-flash","financial_news_extraction":"deepseek-v4-flash","financial_entity_normalization":"deepseek-v4-flash","simple_extraction":"deepseek-v4-flash","complex_extraction":"deepseek-v4-pro","query_planning":"deepseek-v4-pro","summarization":"deepseek-v4-pro","kg_relation_evidence_verify":"glm-5.2","kg_same_fact_gate":"glm-5.2","kg_graph_community_report":"deepseek-v4-pro","kg_graph_community_projection":"deepseek-v4-pro","quality_review":"deepseek-v4-pro"}}

# Relationship-first Graph Community uses isolated readable collections.
MILVUS_GRAPH_COMMUNITY_REPORT_COLLECTION=kg_graph_community_reports
MILVUS_GRAPH_COMMUNITY_PROJECTION_COLLECTION=kg_graph_community_projections
KG_GRAPH_COMMUNITY_REPORT_QUIET_WINDOW_SECONDS=300
KG_GRAPH_COMMUNITY_CLUSTER_NODE_THRESHOLD=40
KG_GRAPH_COMMUNITY_CLUSTER_EDGE_THRESHOLD=80
KG_GRAPH_COMMUNITY_LEIDEN_RESOLUTION=1.0
KG_GRAPH_COMMUNITY_LEIDEN_MIN_MODULARITY=0.05
KG_GRAPH_COMMUNITY_MAX_CROSS_EDGE_RATIO=0.35
KG_GRAPH_COMMUNITY_REPORT_MAX_TOKENS=10000
KG_GRAPH_COMMUNITY_PROJECTION_MAX_TOKENS=7000

# ==================== Langfuse Observability ====================
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
KG_LANGFUSE_ENABLED=0
KG_LANGFUSE_AUTH_CHECK=0
KG_LANGFUSE_TAGS=smart-fund-server,kg,relation-graph
