[Unit]
# Installed by internal/remote/install-services.sh.
Description=THS App process load balancer
After=network-online.target ths-collector-bridge@primary.service ths-collector-bridge@futures.service ths-collector-bridge@us-ranking.service ths-collector-bridge@us-etf.service ths-collector-bridge@pool5.service ths-collector-bridge@pool6.service ths-collector-bridge@pool7.service ths-collector-bridge@pool8.service
# Backends are health-filtered dynamically by the gateway. Keep their startup
# ordering, but do not bind the gateway lifecycle to any single App lane: a
# transient bridge restart must not take down the shared 49350/49352 endpoints.
Wants=network-online.target ths-collector-bridge@primary.service ths-collector-bridge@futures.service ths-collector-bridge@us-ranking.service ths-collector-bridge@us-etf.service ths-collector-bridge@pool5.service ths-collector-bridge@pool6.service ths-collector-bridge@pool7.service ths-collector-bridge@pool8.service

[Service]
Type=simple
User=yuyangruan
Group=yuyangruan
ExecStart=/usr/bin/python3 /home/yuyangruan/android-runtime/bin/ths-app-load-balancer.py --listen-port 49350 --stream-listen-port 49352 --backend primary=127.0.0.1:49301 --backend futures=127.0.0.1:49311 --backend us-ranking=127.0.0.1:49321 --backend us-etf=127.0.0.1:49331 --backend pool5=127.0.0.1:49341 --backend pool6=127.0.0.1:49361 --backend pool7=127.0.0.1:49371 --backend pool8=127.0.0.1:49381 --stream-backend primary=49300 --stream-backend futures=49310 --stream-backend us-ranking=49320 --stream-backend us-etf=49330 --stream-backend pool5=49340 --stream-backend pool6=49360 --stream-backend pool7=49370 --stream-backend pool8=49380
Restart=always
RestartSec=3
TimeoutStartSec=30
StandardOutput=append:/home/yuyangruan/android-runtime/logs/app-load-balancer.log
StandardError=append:/home/yuyangruan/android-runtime/logs/app-load-balancer.log

[Install]
WantedBy=multi-user.target
