[Unit]
# Installed by internal/remote/install-services.sh.
Description=THS App Hook isolated collector lane (%i)
After=network-online.target ths-android-emulator.service
Wants=network-online.target
Requires=ths-android-emulator.service

[Service]
Type=simple
User=yuyangruan
Group=yuyangruan
Environment=HOME=/home/yuyangruan
Environment=ANDROID_SDK_ROOT=/home/yuyangruan/android-sdk
Environment=THS_ANDROID_SERIAL=emulator-5556
Environment=THS_EXPECTED_APP_VERSION_CODE=5235
Environment=THS_EXPECTED_APP_SHA256=03f8d87002b307728d372ddb1978a43732814183073cbc63f0a95bf6a7293eb3
EnvironmentFile=/etc/smart-fund/ths-bridge-%i.env
ExecStart=/home/yuyangruan/android-runtime/bin/ths-collector-bridge.sh
Restart=always
RestartSec=5
TimeoutStartSec=330
TimeoutStopSec=30
StandardOutput=append:/home/yuyangruan/android-runtime/logs/collector-bridge-%i.log
StandardError=append:/home/yuyangruan/android-runtime/logs/collector-bridge-%i.log

[Install]
WantedBy=multi-user.target
